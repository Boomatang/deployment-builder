{
  "name": "my-deployment",
  "version": "1.0.0",
  "environment": "production",
  "cluster_name": "my-cluster",
  "resources": {
    "cpu": "2",
    "memory": "4Gi",
    "replicas": 3
  },
  "services": [
    {
      "name": "web",
      "port": 8080,
      "image": "nginx:latest"
    },
    {
      "name": "api",
      "port": 3000,
      "image": "node:18-alpine"
    }
  ]
}
